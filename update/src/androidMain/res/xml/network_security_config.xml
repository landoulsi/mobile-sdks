<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Global policy: cleartext traffic is never permitted. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Update gateway domains are explicitly required to use HTTPS.
        Integrators should add <pin-set> entries here for certificate pinning
        (with at least one backup pin) once their gateway pins are known.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">stripe.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debug builds may trust user-installed CAs for local testing only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
